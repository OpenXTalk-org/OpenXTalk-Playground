/*
-- You can write an xBuilder library extension that uses com.livecode.emscripten xBuilder language module
-- to evaluate javascript, primarily useful when deploying xTalk stacks to the Web (HTML5 deployment)
-- Below is a complete walkthrough for creating a simple library extension that wraps the JS function showAlert.
*/
library org.openxtalk.jsalert

use com.livecode.foreign
use com.livecode.emscripten
use com.livecode.engine

metadata title is "Test JS module"
metadata author is "Paul McClernan for OpenXTalk"
metadata version is "0.1"

-- Create a public handler to expose to the xTalk script interpreter
  public handler ShowJSAlert(in pMessage as String) returns optional any
     --  put EvalJavaScript("document.createElement('button')") into mButton
     if IsHTML5() then
        EvalJavaScriptWithArguments("alert(arguments[0]);", [pMessage])
        return "OK"
     else
        return "Error: Javascript evaluation works in the HTML5 web context only!"
     end if
  end handler

  private handler IsHTML5() returns Boolean
      return the operating system is "emscripten"
  end handler

end library

/*
-- Invoke the Extension handler from xTalk Script:
on mouseUp
   -- Call the public handler defined in your JS wrapper extension
   ShowJSAlert "Hello from OXT-Beyond xTalk! via JavaScript!"
end mouseUp
*/
